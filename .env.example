# Leave SUGGESTAPI_PUBLIC_KEY empty to shop the recorded guest catalog
# (mock.shop products in SuggestAPI response shape). Tests always use fixtures.
SUGGESTAPI_BASE_URL=https://api.suggestapi.com
SUGGESTAPI_PUBLIC_KEY=
SUGGESTAPI_INDEX=ecommerce

# Commerce adapter: Shopify Storefront Cart API. mock.shop needs no token.
SHOPIFY_GRAPHQL_URL=https://mock.shop/api
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Without a key the shopper uses a deterministic tool loop (no model).
# The model only sees tool JSON (products, cart). Keys stay in this process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=3000
