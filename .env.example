# Leave SUGGESTAPI_PUBLIC_KEY empty to shop the local catalog file.
# Search does not call mock.shop. Cart checkout still uses Shopify Storefront.
SUGGESTAPI_BASE_URL=https://api.suggestapi.com
SUGGESTAPI_PUBLIC_KEY=
SUGGESTAPI_INDEX=ecommerce

# Cart only. mock.shop needs no token. Product search does not use this URL.
SHOPIFY_GRAPHQL_URL=https://mock.shop/api
SHOPIFY_STOREFRONT_TOKEN=

# Optional. Without a key the shopper uses a deterministic tool loop (no model).
# The model only sees tool JSON (products, cart). Keys stay in this process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=3005
